{
  "name": "el-kimiya-hybrid-learning",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:source": "node scripts/check-source.mjs",
    "firebase:check": "node scripts/firebase-preflight.mjs",
    "verify": "npm run test:source && npm run typecheck && npm run build",
    "v33:check": "node scripts/check-v33.mjs",
    "release:build": "node scripts/release-preflight.mjs && npm run verify && node scripts/check-v33.mjs && node scripts/release-preflight.mjs --dist"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^1.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
