# Copy to .env and populate with values from Firebase Console -> Project settings -> Web app.
# Web app configuration and reCAPTCHA site keys are PUBLIC identifiers, not server secrets.
# Never put a Gemini API key, service account JSON, or App Check debug token in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

# Choose the SAME provider you registered under Firebase App Check > Apps.
# Recommended: enterprise if you registered reCAPTCHA Enterprise; or v3 for reCAPTCHA v3.
VITE_APPCHECK_PROVIDER=enterprise
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Legacy alias if you're already using a reCAPTCHA v3 project:
# VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Set true ONLY on localhost while acquiring the App Check debug token.
# Debug tokens themselves must NOT be committed or deployed.
VITE_APPCHECK_DEBUG=false
