# Create a Firebase project, enable AI Logic (Gemini Developer API) and enforce App Check.
# Vite public config values are NOT secrets. Never include a debug token in source control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
# For localhost only: get the generated token from browser console and register it in Firebase.
# This is ignored in production builds by src/lib/hybrid.ts.
VITE_APPCHECK_DEBUG=false
